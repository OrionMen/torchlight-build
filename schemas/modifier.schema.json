{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/modifier.schema.json",
  "title": "Torchlight Modifier",
  "type": "object",
  "required": ["id", "name_zh", "source", "target_node", "aggregation_key", "operation", "value", "filters", "confidence", "version"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name_zh": {"type": "string", "minLength": 1},
    "description_zh": {"type": "string"},
    "source": {
      "type": "object",
      "required": ["entity_type", "entity_id", "original_text"],
      "properties": {
        "entity_type": {"type": "string"},
        "entity_id": {"type": "string"},
        "location": {"type": "string"},
        "original_text": {"type": "string"}
      },
      "additionalProperties": false
    },
    "target_node": {"type": "string"},
    "aggregation_key": {"type": "string"},
    "operation": {"enum": ["add", "subtract", "multiply", "set", "capability_acquire"]},
    "value": {"type": "number"},
    "scope": {"type": "object"},
    "filters": {
      "type": "object",
      "properties": {
        "skill_tags_all": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "skill_tags_any": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "skill_tags_none": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "damage_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "version": {"type": "string"},
    "design_notes_zh": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
